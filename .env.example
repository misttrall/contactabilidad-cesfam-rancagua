# Copiar a .env (raíz) y apps/api/.env (nunca versionar). Valores de desarrollo, no sensibles.
AMBIENTE=DEMO
DATABASE_URL=postgresql://businesshub:businesshub@localhost:5432/businesshub
REDIS_URL=redis://localhost:6379

# Identidad (Keycloak). En QA/PRODUCCION el emisor debe ser https.
KEYCLOAK_ISSUER=http://localhost:8081/realms/businesshub
KEYCLOAK_AUDIENCE=businesshub-api
# KEYCLOAK_JWKS_URL=          # solo si la API ve Keycloak por otra red (p. ej. dentro de Docker)

API_PORT=3000
PUBLIC_API_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:5173

WHATSAPP_MODO=simulador
# WHATSAPP_TOKEN=            # solo en QA/PROD, vía gestor de secretos
# WHATSAPP_APP_SECRET=

# Web (Vite)
VITE_AMBIENTE=DEMO
VITE_API_URL=http://localhost:3000
VITE_KEYCLOAK_ISSUER=http://localhost:8081/realms/businesshub
