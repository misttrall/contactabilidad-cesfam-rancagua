# Copiar a .env (raíz) y apps/api/.env (nunca versionar). Valores de desarrollo, no sensibles.
AMBIENTE=DEMO
DATABASE_URL=postgresql://businesshub:businesshub@localhost:5432/businesshub
REDIS_URL=redis://localhost:6379

# Identidad (Keycloak). En QA/PRODUCCION el emisor debe ser https.
KEYCLOAK_ISSUER=http://localhost:8081/realms/businesshub
KEYCLOAK_AUDIENCE=businesshub-api
# Cuenta de servicio para administrar usuarios desde el sistema (solo desarrollo; en QA/PROD usar un secreto propio)
KEYCLOAK_ADMIN_CLIENT_ID=businesshub-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-admin-secret-no-usar-en-produccion
# KEYCLOAK_JWKS_URL=          # solo si la API ve Keycloak por otra red (p. ej. dentro de Docker)

API_PORT=3000
PUBLIC_API_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:5173

# WhatsApp: "simulador" (demo, no sale nada a internet) o "cloud" (WhatsApp Business Platform).
# Con "cloud" son obligatorias las cuatro credenciales; en PRODUCCION solo se admite "cloud".
WHATSAPP_MODO=simulador
# WHATSAPP_TOKEN=            # vía gestor de secretos, nunca en el repositorio
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=       # verifica la firma X-Hub-Signature-256 del webhook
# WHATSAPP_VERIFY_TOKEN=     # token del GET de verificación del webhook
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_PLANTILLA_CONFIRMACION=confirmacion_hora_v1
# WHATSAPP_PLANTILLA_RECORDATORIO=recordatorio_hora_v1
# BARRIDO_INTERVALO_MS=300000   # cada cuánto se revisan los vencimientos (0 = desactivado)

# Web (Vite)
VITE_AMBIENTE=DEMO
VITE_API_URL=http://localhost:3000
VITE_KEYCLOAK_ISSUER=http://localhost:8081/realms/businesshub

# Clave AES-256 para cifrar teléfonos en la BD (32 bytes en base64). En DEMO hay una clave pública de
# desarrollo; en QA/PRODUCCION es OBLIGATORIA y viene del gestor de secretos:  openssl rand -base64 32
# DATA_ENCRYPTION_KEY=

# Pruebas de integración (base aparte, nunca la de desarrollo)
# TEST_DATABASE_URL=postgresql://businesshub:businesshub@localhost:5432/businesshub_test
# TEST_REDIS_URL=redis://localhost:6379
