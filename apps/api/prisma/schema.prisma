// Modelo de datos del MVP (S1: identidad, roles y catálogos).
// Normalizado respecto del prototipo (informe 6.10): Usuario y Centro son entidades, no texto.
// Los ids son UUID y se reutilizan como `id` de los recursos FHIR (Organization, Location, Practitioner).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  funcionaria
  encargado
  administrador
}

/// Cesfam. Se identifica en el token de Keycloak por `codigo` (claim centro_id).
model Centro {
  id            String        @id @default(uuid()) @db.Uuid
  codigo        String        @unique
  nombre        String
  activo        Boolean       @default(true)
  creadoEn      DateTime      @default(now()) @db.Timestamptz(6)
  usuarios      Usuario[]
  profesionales Profesional[]
  citas         Cita[]
  cargas        Carga[]
  envios        Envio[]

  @@map("centro")
}

/// Espejo mínimo de la identidad de Keycloak (alta automática en el primer ingreso).
/// No se guarda correo ni contraseña: la identidad vive en Keycloak.
model Usuario {
  id            String    @id @default(uuid()) @db.Uuid
  keycloakId    String    @unique
  nombre        String
  rol           Rol
  centroId      String?   @db.Uuid
  centro        Centro?   @relation(fields: [centroId], references: [id])
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now()) @db.Timestamptz(6)
  ultimoIngreso DateTime? @db.Timestamptz(6)

  @@index([centroId])
  @@map("usuario")
}

model Profesional {
  id           String  @id @default(uuid()) @db.Uuid
  nombre       String
  especialidad String?
  centroId     String  @db.Uuid
  centro       Centro  @relation(fields: [centroId], references: [id])
  activo       Boolean @default(true)
  citas        Cita[]

  @@index([centroId])
  @@map("profesional")
}

/// Catálogo de motivos de llamada entrante (informe 4.1, tabla 11).
model MotivoLlamada {
  id          String  @id @default(uuid()) @db.Uuid
  codigo      String  @unique
  descripcion String
  orden       Int     @default(0)
  activo      Boolean @default(true)

  @@map("motivo_llamada")
}

/// Parámetros de operación (anticipación de envío, ventana horaria, segundo mensaje...).
model Parametro {
  clave          String   @id
  valor          Json
  actualizadoEn  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  actualizadoPor String?  @db.Uuid

  @@map("parametro")
}

/// Bitácora append-only (Ley 21.719 / informe 13.3). La migración `auditoria_append_only`
/// impide UPDATE y DELETE con un trigger. NUNCA guardar RUT completo ni datos clínicos en `detalle`.
model AuditEvent {
  id        BigInt   @id @default(autoincrement())
  ocurrioEn DateTime @default(now()) @db.Timestamptz(6)
  usuarioId String?  @db.Uuid
  /// Código estable, p. ej. "motivo.actualizar", "sesion.ingreso", "acceso.denegado".
  accion    String
  recurso   String
  recursoId String?
  centroId  String?  @db.Uuid
  ip        String?
  detalle   Json?

  @@index([ocurrioEn])
  @@index([usuarioId])
  @@index([accion])
  @@map("audit_event")
}

// ============================================================================ S2: citas y cargas

enum TipoCita {
  cronico
  morbilidad
}

/// Estado de contactabilidad (informe 4.3). El estado del proceso vive aquí; la agenda es de AVIS.
enum EstadoContacto {
  sin_enviar
  enviado
  confirmado
  sin_respuesta
  cancelado
}

enum SubestadoContacto {
  recado
  no_ubicado
}

enum SexoPaciente {
  M
  F
}

/// Datos de contacto del paciente. RUT único. El teléfono se guarda cifrado a nivel de aplicación
/// (AES-256-GCM); el resto depende del cifrado en reposo del disco/BD (S6).
model Paciente {
  id              String           @id @default(uuid()) @db.Uuid
  rut             String           @unique
  nombre          String
  telefonoCifrado String?
  /// HMAC del teléfono: permite ubicar al paciente que responde por WhatsApp sin descifrar la tabla.
  telefonoHash    String?
  /// El paciente pidió no recibir más mensajes por WhatsApp (se le llama por teléfono).
  whatsappBaja    Boolean          @default(false)
  whatsappBajaEn  DateTime?        @db.Timestamptz(6)
  fechaNacimiento DateTime?        @db.Date
  sexo            SexoPaciente?
  creadoEn        DateTime         @default(now()) @db.Timestamptz(6)
  actualizadoEn   DateTime         @updatedAt @db.Timestamptz(6)
  citas           Cita[]
  mensajes        Mensaje[]
  consentimientos Consentimiento[]

  @@index([telefonoHash])
  @@map("paciente")
}

model Cita {
  id                String         @id @default(uuid()) @db.Uuid
  centroId          String         @db.Uuid
  centro            Centro         @relation(fields: [centroId], references: [id])
  pacienteId        String         @db.Uuid
  paciente          Paciente       @relation(fields: [pacienteId], references: [id])
  profesionalId     String?        @db.Uuid
  profesional       Profesional?   @relation(fields: [profesionalId], references: [id])
  /// Texto tal como viene de AVIS (el profesional puede no existir aún en el catálogo).
  profesionalNombre String
  /// Versión normalizada (sin tildes, minúsculas) para la clave de idempotencia.
  profesionalClave  String
  fecha             DateTime       @db.Date
  hora              String
  prestacion        String
  tipo              TipoCita
  cargaId           String         @db.Uuid
  carga             Carga          @relation(fields: [cargaId], references: [id])
  creadoEn          DateTime       @default(now()) @db.Timestamptz(6)
  tarea             TareaContacto?
  mensajes          Mensaje[]
  liberacion        Liberacion?

  /// Recargar la misma planilla no duplica citas.
  @@unique([centroId, pacienteId, fecha, hora, profesionalClave])
  @@index([centroId, fecha])
  @@map("cita")
}

/// Estado del flujo de confirmación de una cita (1:1). Se mapea a FHIR Task (ADR-001 §2.4).
model TareaContacto {
  id            String             @id @default(uuid()) @db.Uuid
  citaId        String             @unique @db.Uuid
  cita          Cita               @relation(fields: [citaId], references: [id], onDelete: Cascade)
  estado        EstadoContacto     @default(sin_enviar)
  subestado     SubestadoContacto?
  enviadoEn     DateTime?          @db.Timestamptz(6)
  respondidoEn  DateTime?          @db.Timestamptz(6)
  respuesta     RespuestaPaciente?
  formaContacto FormaContacto?
  actualizadoEn DateTime           @updatedAt @db.Timestamptz(6)

  @@index([estado])
  @@map("tarea_contacto")
}

/// Metadatos de cada importación. NO guarda el archivo ni su nombre (puede contener datos).
model Carga {
  id                 String   @id @default(uuid()) @db.Uuid
  centroId           String   @db.Uuid
  centro             Centro   @relation(fields: [centroId], references: [id])
  /// `sub` de Keycloak de quien importó.
  usuarioId          String
  creadaEn           DateTime @default(now()) @db.Timestamptz(6)
  filasTotales       Int
  filasValidas       Int
  citasCreadas       Int
  citasExistentes    Int
  morbilidadExcluida Int
  repetidasEnArchivo Int
  erroresTotal       Int
  excluyoMorbilidad  Boolean
  citas              Cita[]

  @@index([centroId, creadaEn])
  @@map("carga")
}

// ============================================================================ S3: confirmación por WhatsApp

enum TipoMensaje {
  confirmacion
  recordatorio
  reagendamiento
}

enum EstadoMensaje {
  en_cola
  enviado
  entregado
  leido
  fallido
}

enum RespuestaPaciente {
  si
  no
}

enum FormaContacto {
  whatsapp
  llamada
}

/// Un mensaje saliente. (citaId, tipo) es único: nunca se envía dos veces el mismo tipo de mensaje
/// para una cita (deduplicación incluso si dos personas pulsan "Enviar" a la vez). Se mapea a FHIR Communication.
model Mensaje {
  id             String        @id @default(uuid()) @db.Uuid
  citaId         String        @db.Uuid
  cita           Cita          @relation(fields: [citaId], references: [id], onDelete: Cascade)
  pacienteId     String        @db.Uuid
  paciente       Paciente      @relation(fields: [pacienteId], references: [id])
  envioId        String?       @db.Uuid
  envio          Envio?        @relation(fields: [envioId], references: [id])
  tipo           TipoMensaje
  estado         EstadoMensaje @default(en_cola)
  plantilla      String
  /// ID del mensaje en WhatsApp (wamid); el webhook lo usa para actualizar el estado.
  proveedorId    String?       @unique
  intentos       Int           @default(0)
  /// Código de error del proveedor (nunca el contenido del mensaje).
  errorCodigo    String?
  creadoEn       DateTime      @default(now()) @db.Timestamptz(6)
  programadoPara DateTime?     @db.Timestamptz(6)
  enviadoEn      DateTime?     @db.Timestamptz(6)
  entregadoEn    DateTime?     @db.Timestamptz(6)
  leidoEn        DateTime?     @db.Timestamptz(6)
  fallidoEn      DateTime?     @db.Timestamptz(6)

  @@unique([citaId, tipo])
  @@index([envioId])
  @@index([estado])
  @@map("mensaje")
}

/// Lote de envío pedido por una funcionaria (para el resumen y el seguimiento).
model Envio {
  id                  String    @id @default(uuid()) @db.Uuid
  centroId            String    @db.Uuid
  centro              Centro    @relation(fields: [centroId], references: [id])
  /// `sub` de Keycloak de quien lo pidió.
  usuarioId           String
  creadoEn            DateTime  @default(now()) @db.Timestamptz(6)
  solicitadas         Int
  encoladas           Int
  omitidasSinTelefono Int
  omitidasBaja        Int
  omitidasEstado      Int
  mensajes            Mensaje[]

  @@index([centroId, creadoEn])
  @@map("envio")
}

/// Mensajes recibidos de pacientes, solo para deduplicar reintentos del webhook (no guarda el texto).
model MensajeEntrante {
  id          String   @id @default(uuid()) @db.Uuid
  proveedorId String   @unique
  recibidoEn  DateTime @default(now()) @db.Timestamptz(6)
  /// si | no | baja | ignorado
  resultado   String
  citaId      String?  @db.Uuid

  @@map("mensaje_entrante")
}

/// El paciente respondió «No»: alguien debe liberar la hora en AVIS (que es dueño de la agenda).
model Liberacion {
  id          String    @id @default(uuid()) @db.Uuid
  citaId      String    @unique @db.Uuid
  cita        Cita      @relation(fields: [citaId], references: [id], onDelete: Cascade)
  creadaEn    DateTime  @default(now()) @db.Timestamptz(6)
  resueltaEn  DateTime? @db.Timestamptz(6)
  /// `sub` de Keycloak de quien la resolvió.
  resueltaPor String?

  @@index([resueltaEn])
  @@map("liberacion")
}

/// Historial de bajas del canal WhatsApp (informe 13.3). Se mapea a FHIR Consent.
model Consentimiento {
  id           String   @id @default(uuid()) @db.Uuid
  pacienteId   String   @db.Uuid
  paciente     Paciente @relation(fields: [pacienteId], references: [id])
  canal        String
  /// revocado (el paciente pidió no recibir más mensajes)
  estado       String
  origen       String
  registradoEn DateTime @default(now()) @db.Timestamptz(6)

  @@index([pacienteId])
  @@map("consentimiento")
}
