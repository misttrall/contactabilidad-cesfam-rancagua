# Plantilla de variables de DEMO/QA. Copiar a .env.qa (NO versionar) y completar.
# Todo secreto sale del gestor de secretos del proveedor; aquí solo hay marcadores.
AMBIENTE=QA                      # DEMO | QA | PRODUCCION
AMBIENTE_NOMBRE=qa

# URLs públicas (https)
PUBLIC_API_URL=https://api.qa.ejemplo.cl
WEB_ORIGIN=https://app.qa.ejemplo.cl
KEYCLOAK_ISSUER=https://id.qa.ejemplo.cl/realms/businesshub
KEYCLOAK_ORIGEN=https://id.qa.ejemplo.cl
KC_HOSTNAME=id.qa.ejemplo.cl
# Quién puede embeber la web (p. ej. AVIS si se integra en un iframe). Por defecto, nadie.
CSP_FRAME_ANCESTORS='none'

# Secretos.
#  - Contraseñas que van dentro de una URL (Postgres, Redis): SOLO hexadecimal, `openssl rand -hex 32`
#    (base64 trae / + = que invalidan la URL de conexión).
#  - Claves AES (DATA_ENCRYPTION_KEY): `openssl rand -base64 32`.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
KC_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_ADMIN_SECRET=                 # cliente businesshub-admin (≥ 24 caracteres); el mismo que usa generar-realm.mjs
DATA_ENCRYPTION_KEY=             # AES-256 de teléfonos (32 bytes en base64)
# DATA_ENCRYPTION_KEY_ANTERIORES=  # solo durante una rotación (ver docs/mvp/OPERACION.md)
RETENCION_MESES=12

# WhatsApp (en PRODUCCION es obligatorio WHATSAPP_MODO=cloud)
WHATSAPP_MODO=simulador
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
