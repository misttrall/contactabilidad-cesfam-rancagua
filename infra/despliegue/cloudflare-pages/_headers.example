# Copiar a apps/web/dist/_headers (o apps/web/public/_headers) y reemplazar los orígenes.
#   API = origen público de la API (túnel),  ID = origen de Keycloak
# Equivale a infra/despliegue/seguridad.inc.template (nginx).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://API.ejemplo.cl https://ID.ejemplo.cl; frame-src https://ID.ejemplo.cl; frame-ancestors 'none'; base-uri 'none'; form-action 'self' https://ID.ejemplo.cl; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable
