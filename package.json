{
  "name": "businesshub-salud",
  "private": true,
  "version": "0.2.0",
  "description": "BusinessHub Salud - Contactabilidad CESFAM Rancagua (MVP)",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,yml}\" --ignore-path .prettierignore",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "test:infra": "node --test infra/",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,yml}\" --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2"
  }
}
