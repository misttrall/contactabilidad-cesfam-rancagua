{
  "name": "businesshub-salud",
  "private": true,
  "version": "0.2.0",
  "description": "BusinessHub Salud - Contactabilidad CESFAM Rancagua (MVP)",
  "packageManager": "pnpm@11.15.1",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css,yml}\" --ignore-path .gitignore",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
